# cp .env.example .env  — 설명은 README 의 "환경 변수" 표

# LLM: 앱 → LiteLLM(deploy/litellm.yaml) → 팀 vLLM → Codyssey 폴백
# OPENAI_API_KEY 는 LiteLLM 마스터 키: echo "sk-$(openssl rand -hex 32)"
OPENAI_API_KEY=
OPENAI_BASE_URL=http://localhost:4000/v1
OPENAI_MODEL_NAME=main
CODYSSEY_API_KEY=
VLLM_BASE_URL=
VLLM_API_KEY=

# Anthropic(Codyssey, /v1 없이) · Gemini
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://copa.codyssey.kr
ANTHROPIC_MODEL_NAME=claude-haiku-4
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash

# 노드별 공급자: openai | anthropic | gemini (비우면 MAIN)
MAIN_MODEL_PROVIDER=openai
SUMMARY_MODEL_PROVIDER=openai
ROUTER_MODEL_PROVIDER=
SEARCH_MODEL_PROVIDER=
RAG_MODEL_PROVIDER=
GUARDRAIL_MODEL_PROVIDER=

# 에이전트
AGENT_PATTERN=router
GUARDRAIL_ENABLED=true
HITL_TOOLS=
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=5

# RAG (공급자·차원을 바꾸면 ingest 다시)
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
RAG_TOP_K=5

# 시간 제한(초) · 요약(토큰)
OPENAI_TIMEOUT_SECONDS=40
ANTHROPIC_TIMEOUT_SECONDS=40
GEMINI_TIMEOUT_SECONDS=20
AI_TIMEOUT_SECONDS=60
SUMMARY_TRIGGER_TOKENS=8000
SUMMARY_KEEP_TOKENS=4000

# Supabase (DATABASE_URL 은 Session pooler 5432)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# 앱
ADMIN_EMAILS=
COOKIE_SECURE=false
LOG_LEVEL=INFO
MAX_MESSAGE_LENGTH=2000
