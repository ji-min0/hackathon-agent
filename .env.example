# 이 파일을 .env 로 복사한 뒤 실제 값을 채운다.
#   cp .env.example .env
# .env 는 .gitignore 에 등록되어 있으므로 저장소에 올라가지 않는다.

# ---------------------------------------------------------------------------
# LLM
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-5-mini
# OpenAI 호환 서버 주소(Codyssey 게이트웨이, vLLM 등). 비우면 OpenAI 공식 서버로 간다.
OPENAI_BASE_URL=https://copa.codyssey.kr/v1

# OpenAI 실패 시 첫 번째 폴백. 키를 비우면 폴백 목록에서 빠진다.
# /v1 없이 적는다. SDK 가 /v1/messages 를 붙인다.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_NAME=claude-haiku-4
ANTHROPIC_BASE_URL=https://copa.codyssey.kr

# Gemini는 기본 모델이 아니다. 요약 모델을 바꾸거나 OpenAI 폴백을 사용할 때만 필요하다.
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash

# main · summary 모두 기본값은 openai다. 필요할 때만 anthropic / gemini로 바꾼다.
MAIN_MODEL_PROVIDER=openai
SUMMARY_MODEL_PROVIDER=openai

# 공급자별 단일 HTTP 호출 제한과 전체 Agent 호출 제한.
OPENAI_TIMEOUT_SECONDS=40
ANTHROPIC_TIMEOUT_SECONDS=40
GEMINI_TIMEOUT_SECONDS=20
AI_TIMEOUT_SECONDS=60

# 요약 미들웨어. 대화가 TRIGGER 토큰을 넘으면 KEEP 토큰만 남기고 압축한다.
SUMMARY_TRIGGER_TOKENS=8000
SUMMARY_KEEP_TOKENS=4000

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Dashboard → Project Settings → Database → Connection string
# 반드시 Connection Pooler 의 Session 모드(5432)를 사용한다.
# Transaction 모드(6543)는 prepared statement 를 지원하지 않아 간헐적 오류가 난다.
# 비밀번호에 특수문자가 있으면 URL 인코딩한다. 예) ! → %21
#
# 형식: postgresql://postgres.<프로젝트ID>:<비밀번호>@<리전>.pooler.supabase.com:5432/postgres
# 예시: postgresql://postgres.abcdefghijklmnop:pw%21%21@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Dashboard → Settings → API Keys
# 예시: https://abcdefghijklmnop.supabase.co
SUPABASE_URL=
# Publishable key (구버전 표기는 anon public). sb_publishable_ 로 시작한다.
SUPABASE_ANON_KEY=

# 선택값. 현재 코드에서는 사용하지 않으므로 비워 두어도 된다.
# 데이터 접근은 DATABASE_URL 로 직접 하고, 인증은 anon 키로 충분하다.
# 관리자 전용 작업이 필요해지면 Secret key 를 넣는다. 절대 클라이언트로 내보내지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# 애플리케이션
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
MAX_MESSAGE_LENGTH=2000

# 체크포인트 역직렬화 시 허용되지 않은 타입을 제한한다.
LANGGRAPH_STRICT_MSGPACK=true

# 로컬 개발은 HTTP 라 false, 배포(HTTPS)에서는 true 로 둔다.
COOKIE_SECURE=false
